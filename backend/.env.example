# ==============================================================
# Deployment Playground - Express Backend Environment Variables
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Supabase (PostgreSQL) Configuration
# Found in Supabase Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# MongoDB Configuration (MongoDB Atlas or standalone instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=deployment_playground

# Redis Configuration (Redis Cloud, Upstash, or standalone)
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=
