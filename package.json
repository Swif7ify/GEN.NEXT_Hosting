{
  "name": "deployment-playground",
  "version": "1.0.0",
  "private": true,
  "description": "Single-Page Deployment Playground across Vercel, Render, and Coolify",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:mobile": "cd mobile && npm start",
    "dev:mobile:web": "cd mobile && npm run web",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "test:validation": "cd backend && npx tsx src/testValidator.ts",
    "test:validation:mobile": "cd mobile && npm run test:validation",
    "test:integration": "node testEndpoints.mjs"
  }
}
